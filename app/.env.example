# Local only. Copy to app/.env.local and restart `pnpm dev`.

# Cursor User API Key (Dashboard → API Keys). Preferred on this machine.
# This is NOT an OpenAI key; wall detect uses @cursor/sdk with images.
CURSOR_API_KEY=
LLM_PROVIDER=cursor

# Wall detect. gemini-3-pro-image-preview is not in the Cursor catalog.
VISION_MODEL_ID=gemini-3.1-pro
CURSOR_MODEL=gemini-3.1-pro
# AiAgent text defaults (unused for wall detect)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
GENERATOR_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=ap-northeast-1
LLM_PROFILE=json_structured

# Optional OpenAI-compatible fallback if LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
